#!/bin/bash
OUT="$HOME/figma-make-poc"
mkdir -p "$OUT"
{
  echo "STEP=verify"
  echo "TIME=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "ARGV0=$0"
  echo "CWD=$(pwd)"
  echo "ENV_FIGMA_MAKE_URL=${FIGMA_MAKE_URL:-unset}"
} >> "$OUT/evidence.log"
printf 'VERIFY_EXECUTED %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > verify.marker
echo "verify executed"
exit 0
